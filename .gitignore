# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment (a directory, or a symlink in a session worktree)
.venv

# Environment / secrets
.env
.env.*

# Claude Code personal overrides (project settings in .claude/settings.json are shared)
.claude/settings.local.json

# VS Code
.vscode/

# macOS
.DS_Store

# Test/cache
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Generated data
data/raw/*
data/processed/*

# Keep folders
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models
models/
*.zip
*.pt
*.pth

# Logs
*.log
reports/

# Local SQLite stores (the Stock Lab's store is private vendor data and a watchlist)
*.sqlite3
*.sqlite3-*

# Streamlit local secrets (never committed)
.streamlit/secrets.toml
